---
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '@/config/i18n';
import { SITE_URL } from '@/config/seo';
import { buildAboutPageLD } from '@/config/structured-data';
import { getLabelsData, getPageData } from '@/config/translations';
import ArticleTocOverlay from '@/features/content/components/ArticleTocOverlay.astro';
import ArticleTocSidebar from '@/features/content/components/ArticleTocSidebar.astro';
import SuggestChangesLink from '@/features/content/components/SuggestChangesLink.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

/* Skip languages without an about page (no fallback hop). */
export const getStaticPaths = async () => {
  const filled = await Promise.all(
    SUPPORTED_LANGUAGES.map(async (lang) => ({
      lang,
      has: (await getPageData('about', lang)) !== undefined,
    })),
  );
  return filled.filter(({ has }) => has).map(({ lang }) => ({ params: { lang } }));
};

const { lang } = Astro.params;

const page = await getPageData('about', lang);
// Unreachable in practice — getStaticPaths excludes empty langs —
// but Astro requires `page` to be narrowed for the render below.
if (!page) throw new Error(`about page missing for ${lang}`);

const rendered = await page.render();
const Content = rendered.Content;
const headings = rendered.headings ?? [];
const labels = (await getLabelsData(lang)) ?? (await getLabelsData(DEFAULT_LANGUAGE));
const tocLabel = labels?.data.tableOfContents ?? 'Contents';

const pageUrl = `${SITE_URL}/${lang}/about`;
const aboutPageLD = buildAboutPageLD({
  title: page.data.title,
  ...(page.data.description ? { description: page.data.description } : {}),
  lang,
  url: pageUrl,
});
---

<BaseLayout title={`${page.data.title} - Prometheus`} {...(page.data.description ? { description: page.data.description } : {})} lang={lang}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(aboutPageLD)} />
  <article class="section">
    <ArticleTocSidebar headings={headings} label={tocLabel} articleTitle={page.data.title} />
    <div class="container">
      <div class="about-header" id="article-top">
        <h1>{page.data.title}</h1>
        {page.data.subtitle ? <p class="lead">{page.data.subtitle}</p> : null}
      </div>
      <div class="prose">
        <Content />
      </div>
      <SuggestChangesLink collection="pages" entryId={page.id} />
    </div>
  </article>
  <ArticleTocOverlay
    slot="floating"
    headings={headings}
    label={tocLabel}
    articleTitle={page.data.title}
  />
</BaseLayout>

<style>
  /*
   * Positioning context for the absolute TOC sidebar rail — see
   * ArticleTocSidebar.astro for the layout strategy.
   */
  article.section {
    position: relative;
  }

  .about-header {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
    margin-bottom: var(--spacing-2xl);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .lead {
    margin-top: var(--spacing-md);
    color: var(--color-text-secondary);
    font-size: 1.125rem;
  }

  .prose {
    max-width: 800px;
    margin-inline: auto;
  }

  .prose :global(h2) {
    font-size: 1.75rem;
    font-weight: 600;
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-md);
  }

  .prose :global(p) {
    margin-bottom: var(--spacing-md);
    line-height: 1.8;
  }

  .prose :global(strong) {
    font-weight: 600;
  }
</style>
