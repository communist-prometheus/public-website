---
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '@/config/i18n';
import { getLabelsData } from '@/config/translations';
import { getArchiveItems, getArchiveSlug } from '@/features/archive/helpers/getArchiveItems';
import PostCard from '@/features/blog/components/PostCard.astro';
import { deriveSummary } from '@/features/content/helpers/deriveSummary';
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
 * Build the archive listing for every supported language. The nav link
 * is gated by the `archive` feature flag + per-language availability,
 * but a directly-reached URL must still resolve to the empty-state page
 * rather than a 404 (same rationale as blog/newspaper listings).
 */
export const getStaticPaths = async () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;

const items = await getArchiveItems(lang);
const labels = (await getLabelsData(lang)) ?? (await getLabelsData(DEFAULT_LANGUAGE));
const heading = labels?.data.archiveTitle ?? 'Archive';
---

<BaseLayout
  title={heading}
  description="Document and image archive of the Communist Prometheus."
  lang={lang}
>
  <div class="section">
    <div class="container">
      <h1>{heading}</h1>
      {items.length > 0 ? (
        <ul class="archive-grid">
          {items.map((item) => {
            const slug = getArchiveSlug(item);
            const summary = item.data.description ?? deriveSummary(item.body) ?? '';
            return (
              <li>
                <PostCard
                  title={item.data.title}
                  description={summary}
                  slug={slug}
                  image={item.data.image}
                  lang={lang}
                  headingLevel={2}
                  href={`/${lang}/archive/${slug}`}
                />
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="empty-state">No archive items yet.</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin-bottom: var(--spacing-xl);
  }

  .archive-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .archive-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .empty-state {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    text-align: center;
    padding: var(--spacing-xl) 0;
  }
</style>
