---
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from '@/config/i18n';
import { getLabelsData } from '@/config/translations';
import { deriveSummary } from '@/features/content/helpers/deriveSummary';
import NewspaperCard from '@/features/newspaper/components/NewspaperCard.astro';
import { getNewspaperItems } from '@/features/newspaper/helpers/getNewspaperItems';
import BaseLayout from '@/layouts/BaseLayout.astro';

/*
 * Generate the listing for every supported language, even when no
 * issues are published in that language yet — the empty state below
 * shows "No newspaper editions yet" instead of a 404. The previous
 * "skip empty langs" filter meant `/en/newspaper` 404'd on master
 * because only the Russian edition had been published, even though
 * the EN nav linked to it.
 */
export const getStaticPaths = async () => SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;

const items = await getNewspaperItems(lang);
const labels = (await getLabelsData(lang)) ?? (await getLabelsData(DEFAULT_LANGUAGE));
const pdfLabel = labels?.data.downloadPdf ?? 'Download PDF';
const fb2Label = labels?.data.downloadFb2 ?? 'Download FB2';
---

<BaseLayout
  title="Newspaper"
  description="Print editions of the Prometheus newspaper — articles, communiqués and analysis."
  lang={lang}
>
  <div class="section">
    <div class="container">
      <h1>Newspaper</h1>
      {items.length > 0 ? (
        <div class="newspaper-grid">
          {items.map((item) => (
            <NewspaperCard
              title={item.data.title}
              description={deriveSummary(item.body) ?? item.data.description ?? ''}
              slug={item.id.split('/').at(0) ?? item.id}
              lang={lang}
              image={item.data.image ?? undefined}
              headingLevel={2}
              pdfLabel={pdfLabel}
              fb2Label={fb2Label}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">No newspaper editions yet.</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin-bottom: var(--spacing-xl);
  }

  .newspaper-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 768px) {
    .newspaper-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty-state {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    text-align: center;
    padding: var(--spacing-xl) 0;
  }
</style>
