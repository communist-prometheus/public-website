---
import { getReadyLanguages } from '@/config/ready-languages';
import { getLabelsData } from '@/config/translations';
import NewspaperCard from '@/features/newspaper/components/NewspaperCard.astro';
import { getNewspaperItems } from '@/features/newspaper/helpers/getNewspaperItems';
import BaseLayout from '@/layouts/BaseLayout.astro';

export const getStaticPaths = async () =>
  (await getReadyLanguages()).map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;

const items = await getNewspaperItems(lang);
const labels = await getLabelsData(lang);
const readMore = labels?.data.readMore ?? 'Download PDF';
---

<BaseLayout title="Newspaper" lang={lang}>
  <div class="section">
    <div class="container">
      <h1>Newspaper</h1>
      {items.length > 0 ? (
        <div class="newspaper-grid">
          {items.map((item) => (
            <NewspaperCard
              title={item.data.title}
              description={item.data.description}
              slug={item.id.split('/').at(0) ?? item.id}
              image={item.data.image ?? undefined}
              headingLevel={2}
              downloadLabel={readMore}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">No newspaper editions yet.</p>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    margin-bottom: var(--spacing-xl);
  }

  .newspaper-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 768px) {
    .newspaper-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty-state {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    text-align: center;
    padding: var(--spacing-xl) 0;
  }
</style>
