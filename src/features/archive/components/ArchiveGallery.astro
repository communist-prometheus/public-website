---
/*
 * Archive gallery — 1:1 port of wfr-host-astro's Grid + Viewer wiring.
 * The tiles are rendered by <wfr-file-grid>; the shared viewer shell is
 * `<ArchiveViewer>`. Files are computed here per album and passed through
 * both components.
 *
 * The mount script (setFiles + setupViewer + wfr-file-grid registration)
 * lives here so all three imports share the same `files.ts` module — if
 * Grid.astro and Viewer.astro had their own scripts, Vite would emit two
 * bundles that each carry their own copy of the singleton, and setFiles
 * would populate a different module than getFiles reads.
 */
import { getArchiveFileDescriptors } from '@/features/archive/lib/adapter';
import ArchiveFileGrid from './ArchiveFileGrid.astro';
import ArchiveViewer from './ArchiveViewer.astro';

interface Props {
  readonly slug: string;
  /** Cap the number of tiles (the foot-of-article widget passes a few). */
  readonly limit?: number;
}

const { slug, limit } = Astro.props;
const all = await getArchiveFileDescriptors(slug);
const files = typeof limit === 'number' ? all.slice(0, limit) : all;
---

{files.length > 0 && (
  <div class="archive-gallery" data-archive-gallery>
    <ArchiveFileGrid files={files} />
  </div>
)}

<ArchiveViewer />

<script>
  import '@web-file-reader/file-grid';
  import type { FileDescriptor } from '@web-file-reader/core';
  import { setFiles } from '../lib/files';
  import { setupViewer } from '../lib/setup-viewer';

  interface WithFilesProp extends HTMLElement {
    files?: readonly FileDescriptor[];
  }

  const initGallery = (): void => {
    /*
     * Populate every <wfr-file-grid> on the page and mirror the first one's
     * files into the shared `files.ts` singleton — the viewer paging / URL
     * sync reads from it. A blog page can carry multiple albums but the
     * viewer only follows one; the first grid on the page wins.
     */
    let firstFiles: readonly FileDescriptor[] | undefined;
    for (const grid of document.querySelectorAll<WithFilesProp>('wfr-file-grid[data-files]')) {
      if (grid.dataset['ready'] === '1') continue;
      const raw = grid.getAttribute('data-files');
      if (raw === null) continue;
      try {
        const list = JSON.parse(raw) as readonly FileDescriptor[];
        grid.files = list;
        grid.dataset['ready'] = '1';
        if (firstFiles === undefined) firstFiles = list;
      } catch {
        /* malformed JSON — noscript fallback still works */
      }
    }
    if (firstFiles !== undefined) setFiles(firstFiles);
    setupViewer();
  };

  document.addEventListener('astro:page-load', initGallery);
  initGallery();
</script>

<style>
  .archive-gallery {
    display: block;
  }
</style>
