---
import { withBase } from '../lib/base';
---

<!--
  Port of @web-file-reader/host-astro Viewer.astro. The mount script lives in
  ArchiveGallery.astro so both `setFiles()` and `setupViewer()` share the same
  `files.ts` module graph.
-->
<dialog id="viewer-dialog" class="viewer-dialog" aria-label="File viewer" tabindex="-1">
  <div class="chrome">
    <span class="chrome-title" id="viewer-title"></span>
    <span class="chrome-actions">
      <button id="download-button" type="button" aria-label="Download file">Download</button>
      <button id="settings-button" type="button" aria-haspopup="dialog" aria-expanded="false">
        Settings
      </button>
      <button id="fs-button" type="button">Fullscreen</button>
      <a id="close-button" href={withBase('')} aria-label="Close viewer">Close</a>
    </span>
  </div>

  <wfr-settings-panel id="settings-panel" hidden></wfr-settings-panel>

  <div class="stage">
    <div id="track" class="track" role="group" aria-label="Files" tabindex="-1">
      <section class="slide"><wfr-viewer class="pane"></wfr-viewer></section>
      <section class="slide"><wfr-viewer class="pane"></wfr-viewer></section>
      <section class="slide"><wfr-viewer class="pane"></wfr-viewer></section>
    </div>
    <wfr-viewer-nav id="nav"></wfr-viewer-nav>
  </div>
</dialog>

<style is:global>
  /* ==== Dialog shell — ported from wfr-host-astro Layout.astro ==== */
  .viewer-dialog {
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: rgb(8 8 8 / 0.985);
    color: #fff;
    overflow: hidden;
  }
  .viewer-dialog::backdrop {
    background: rgb(0 0 0 / 0.85);
  }
  .viewer-dialog[open] {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .viewer-dialog .chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: rgb(15 15 15 / 0.7);
    backdrop-filter: blur(6px);
  }
  .viewer-dialog .chrome-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: #fff;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex: 1;
    min-width: 0;
  }
  .viewer-dialog .chrome-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }
  .viewer-dialog .chrome button,
  .viewer-dialog .chrome a {
    all: unset;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 0.375rem;
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    font-size: 0.85rem;
    line-height: 1;
    cursor: pointer;
    box-sizing: border-box;
  }
  .viewer-dialog .chrome button:hover,
  .viewer-dialog .chrome a:hover {
    background: rgb(255 255 255 / 0.24);
  }
  .viewer-dialog .chrome button:focus-visible,
  .viewer-dialog .chrome a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .viewer-dialog wfr-settings-panel {
    display: block;
    padding: 0.75rem 1rem;
    background: rgb(20 20 20 / 0.9);
    border-block-end: 1px solid rgb(255 255 255 / 0.12);
    color: #eee;
  }
  .viewer-dialog wfr-settings-panel[hidden] {
    display: none;
  }

  /* ==== Stage: track (3-slide scroll-snap carousel) + nav ==== */
  .viewer-dialog .stage {
    position: relative;
    display: flex;
    min-height: 0;
    background: transparent;
  }
  .viewer-dialog .track {
    display: flex;
    inline-size: 100%;
    block-size: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: auto;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .viewer-dialog .track::-webkit-scrollbar {
    display: none;
  }
  .viewer-dialog .slide {
    flex: 0 0 100%;
    inline-size: 100%;
    block-size: 100%;
    min-inline-size: 0;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    contain: layout paint;
  }
  .viewer-dialog .slide[hidden] {
    display: none !important;
  }
  .viewer-dialog .pane {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 0;
    color: #fff;
  }

  /* wfr-viewer-nav absolute-positioned overlay for prev/next.
     It auto-hides after ~2.5s of inactivity and toggles on tap — its
     built-in behaviour is what the reference host uses. */
  .viewer-dialog wfr-viewer-nav {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    --wfr-nav-gap: 0;
  }
  .viewer-dialog wfr-viewer-nav::part(nav) {
    position: absolute;
    inset: 0;
    justify-content: space-between;
    align-items: center;
    padding-inline: 0.75rem;
  }
  .viewer-dialog wfr-viewer-nav::part(prev),
  .viewer-dialog wfr-viewer-nav::part(next) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.15);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    pointer-events: auto;
  }
  .viewer-dialog wfr-viewer-nav::part(prev):hover,
  .viewer-dialog wfr-viewer-nav::part(next):hover {
    background: rgb(255 255 255 / 0.28);
  }
</style>
