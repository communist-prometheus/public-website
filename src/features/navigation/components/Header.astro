---
import type { Language } from '@/config/i18n';
import ThemeToggle from '@/features/theme/components/ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import Nav from './Nav.astro';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<header data-scroll-header>
  <div class="header-container">
    <div class="header-content">
      <a href={`/${lang}`} class="logo" aria-label="Communist Prometheus">
        <img src="/logo-light.svg" alt="" class="logo-img logo-light" width="160" height="51" />
        <img src="/logo-dark.svg" alt="" class="logo-img logo-dark" width="160" height="51" />
      </a>
      <div class="header-actions">
        <div class="desktop-only" data-testid="desktop-nav">
          <Nav lang={lang} />
        </div>
        <div class="desktop-only">
          <LanguageSwitcher lang={lang} />
        </div>
        <div class="desktop-only">
          <ThemeToggle />
        </div>
        <MobileMenu lang={lang} />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  /*
   * Sticky-with-reveal header. Mirrors the admin's useScrollHeader
   * behaviour: scrolling DOWN past the header height slides it out
   * of view (more reading space on long articles); scrolling UP at
   * any point slides it back. Implemented as a translateY offset
   * with rAF coalescing so it survives 60 fps scroll without
   * thrashing layout. View-Transitions reset the offset on swap.
   */
  (function () {
    var header = document.querySelector('[data-scroll-header]');
    if (!header) return;
    var height = header.getBoundingClientRect().height || 60;
    var lastY = window.scrollY;
    var offset = 0;
    var ticking = false;
    function applyOffset(o) {
      header.style.transform = 'translateY(' + o + 'px)';
    }
    function handleScroll() {
      var y = window.scrollY;
      var dy = y - lastY;
      lastY = y;
      if (y < height) {
        offset = 0;
      } else {
        offset = Math.max(-height, Math.min(0, offset - dy));
      }
      applyOffset(offset);
      ticking = false;
    }
    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(handleScroll);
    }, { passive: true });
    document.addEventListener('astro:before-swap', function () {
      offset = 0;
      lastY = 0;
      applyOffset(0);
    });
  })();
</script>

<style>
  header {
    position: sticky;
    top: 0;
    background: var(--color-surface-elevated);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
    transition: transform var(--transition-fast);
    will-change: transform;
  }

  @media (min-width: 768px) {
    header {
      backdrop-filter: blur(10px);
    }
  }

  .header-container {
    padding-inline: var(--spacing-sm);
  }

  @media (min-width: 768px) {
    .header-container {
      padding-inline: var(--spacing-md);
    }
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--spacing-md);
  }

  .logo {
    text-decoration: none;
    transition: opacity var(--transition-fast);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo-img {
    height: 36px;
    width: auto;
    display: block;
  }

  .logo-dark {
    display: none;
  }

  :global([data-theme='dark']) .logo-light {
    display: none;
  }

  :global([data-theme='dark']) .logo-dark {
    display: block;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .desktop-only {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-only {
      display: flex;
      align-items: center;
    }
  }
</style>
