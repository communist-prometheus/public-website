{
  "name": "@web-file-reader/provider-markdown",
  "version": "0.1.0",
  "description": "Markdown / plain-text / code provider for the web-file-reader viewer. Heavy parser loaded lazily; output is sanitized.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-file-reader",
    "provider",
    "markdown",
    "lazy"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lazy": {
      "types": "./src/lazy.ts",
      "import": "./src/lazy.ts"
    }
  },
  "dependencies": {
    "@web-file-reader/core": "workspace:*",
    "dompurify": "^3.2.3",
    "marked": "^18.0.5"
  },
  "private": true
}
