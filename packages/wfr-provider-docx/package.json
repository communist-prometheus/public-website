{
  "name": "@web-file-reader/provider-docx",
  "version": "0.1.0",
  "description": "DOCX (Word) provider for the web-file-reader viewer. Unzips and reads word/document.xml into sanitized HTML; heavy work loaded lazily.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-file-reader",
    "provider",
    "docx",
    "word",
    "ooxml",
    "lazy"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lazy": {
      "types": "./src/lazy.ts",
      "import": "./src/lazy.ts"
    }
  },
  "dependencies": {
    "@web-file-reader/core": "workspace:*",
    "dompurify": "^3.2.3",
    "fflate": "^0.8.2"
  },
  "private": true
}
