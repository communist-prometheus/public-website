{
  "name": "@web-file-reader/file-grid",
  "version": "0.1.0",
  "description": "Headless, slots-first Lit grid of file tiles (<wfr-file-grid> / <wfr-file-tile>) that emit an open event.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-file-reader",
    "lit",
    "web-component",
    "headless",
    "file-grid"
  ],
  "sideEffects": [
    "**/*.ts",
    "**/*.js"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@web-file-reader/core": "workspace:*",
    "lit": "^3.2.1"
  },
  "private": true
}
