{
  "name": "@web-file-reader/provider-fb2",
  "version": "0.1.0",
  "description": "FictionBook (FB2) provider for the web-file-reader viewer. Parses FB2 XML into sanitized, multi-page HTML; heavy work loaded lazily.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-file-reader",
    "provider",
    "fb2",
    "fictionbook",
    "lazy"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lazy": {
      "types": "./src/lazy.ts",
      "import": "./src/lazy.ts"
    }
  },
  "dependencies": {
    "@web-file-reader/core": "workspace:*",
    "dompurify": "^3.2.3"
  },
  "private": true
}
