{
  "name": "@web-file-reader/settings",
  "version": "0.1.0",
  "description": "Headless Lit settings panel (<wfr-settings-panel>) that renders controls from a provider's settings schema and emits serialized changes.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-file-reader",
    "lit",
    "web-component",
    "headless",
    "settings"
  ],
  "sideEffects": [
    "**/*.ts",
    "**/*.js"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@web-file-reader/core": "workspace:*",
    "lit": "^3.2.1"
  },
  "private": true
}
