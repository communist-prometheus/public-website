{
  "name": "@web-file-reader/provider-pdf",
  "version": "0.1.0",
  "description": "PDF provider for the web-file-reader viewer. Renders pages with pdf.js (loaded lazily); multi-page output with scale & layout settings.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-file-reader",
    "provider",
    "pdf",
    "pdfjs",
    "lazy"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lazy": {
      "types": "./src/lazy.ts",
      "import": "./src/lazy.ts"
    }
  },
  "dependencies": {
    "@web-file-reader/core": "workspace:*",
    "pdfjs-dist": "^6.1.200"
  },
  "private": true
}
