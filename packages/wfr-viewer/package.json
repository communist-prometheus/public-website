{
  "name": "@web-file-reader/viewer",
  "version": "0.1.0",
  "description": "Headless Lit file viewer (<wfr-viewer>) with normal/fullscreen modes and a scrollable single/multi-page surface fed by lazy providers.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-file-reader",
    "lit",
    "web-component",
    "headless",
    "viewer",
    "fullscreen"
  ],
  "sideEffects": [
    "**/*.ts",
    "**/*.js"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "dependencies": {
    "@web-file-reader/core": "workspace:*",
    "lit": "^3.2.1"
  },
  "private": true
}
