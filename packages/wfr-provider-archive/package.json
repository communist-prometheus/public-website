{
  "name": "@web-file-reader/provider-archive",
  "version": "0.1.0",
  "description": "ZIP archive provider for the web-file-reader viewer. Lists archive entries as an accessible table; heavy unzip loaded lazily.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-file-reader",
    "provider",
    "zip",
    "archive",
    "lazy"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lazy": {
      "types": "./src/lazy.ts",
      "import": "./src/lazy.ts"
    }
  },
  "dependencies": {
    "@web-file-reader/core": "workspace:*",
    "fflate": "^0.8.2"
  },
  "private": true
}
