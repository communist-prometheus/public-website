{
  "type": "module",
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "fetch-content": "bun scripts/fetch-content.ts",
    "fetch-favicons": "bun scripts/fetch-favicons.ts",
    "build-favicons": "bun scripts/build-favicons.ts",
    "check-frontmatter": "bun scripts/check-frontmatter-yaml.ts",
    "predev": "bun run fetch-content && bun run check-frontmatter && bun run fetch-favicons && bun run build-favicons",
    "prebuild": "bun run fetch-content && bun run check-frontmatter && bun run fetch-favicons && bun run build-favicons",
    "dev": "astro dev",
    "build": "biome format . && biome check . && eslint . && astro check && bun run check:worker && astro build",
    "check:worker": "tsc -p src/worker/tsconfig.json",
    "preview": "astro preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "lint:comments": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@prometheus/search-core": "workspace:*",
    "@web-file-reader/core": "workspace:*",
    "@web-file-reader/file-grid": "workspace:*",
    "@web-file-reader/navigation": "workspace:*",
    "@web-file-reader/provider-archive": "workspace:*",
    "@web-file-reader/provider-csv": "workspace:*",
    "@web-file-reader/provider-docx": "workspace:*",
    "@web-file-reader/provider-fb2": "workspace:*",
    "@web-file-reader/provider-image": "workspace:*",
    "@web-file-reader/provider-markdown": "workspace:*",
    "@web-file-reader/provider-pdf": "workspace:*",
    "@web-file-reader/settings": "workspace:*",
    "@web-file-reader/viewer": "workspace:*",
    "astro": "^7.0.7",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.1.0",
    "sharp": "^0.34.0",
    "vite": "^6.4.1"
  },
  "packageManager": "bun@latest",
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/workers-types": "^5.20260712.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsdoc": "^62.5.4",
    "husky": "^9.1.7",
    "lighthouse": "^13.0.3",
    "lint-staged": "^16.2.7",
    "playwright-lighthouse": "^4.0.0",
    "to-ico": "^1.1.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
