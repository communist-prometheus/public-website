# build output
dist/

# content collection — tracked in-repo (monorepo). Editors edit the
# standalone public-website-content repo; a sync Action reflects it here.
# Only the nested clone marker is ignored so local `fetch-content` runs
# (dev override) don't stage their own .git.
src/content/.git/

# generated types
.astro/
.astro-cache/
.vite-cache/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# IDE
.vscode/
*.swp
*.swo
*~

# Playwright
e2e/screenshots/
e2e/lighthouse-reports/
test-results/
playwright-report/
screenshots/
/.setting/mcp-mysql.log
/.setting/mcp-mysql-cli.log

# Build-time fetched favicons (regenerated by scripts/fetch-favicons.ts)
public/favicons/

# Wrangler local secrets (template lives in .dev.vars.example)
.dev.vars
**/.dev.vars

# npm lockfile — bun.lock is the single source of dependency truth
package-lock.json

# Wrangler build scratch
.wrangler/
